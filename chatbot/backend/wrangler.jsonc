{
  "name": "victor-travers-cv-chatbot",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {"name": "CHAT_LIMITER", "namespace_id": "1041", "simple": {"limit": 4, "period": 60}},
    {"name": "GLOBAL_LIMITER", "namespace_id": "1042", "simple": {"limit": 30, "period": 60}}
  ]
}